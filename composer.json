{
    "name": "jeffersongoncalves/laravel-zero-package-scaffold",
    "description": "Shared file templates (LICENSE, CI workflows, phpstan/phpunit, README) and namespace-casing resolution for package generator CLIs.",
    "keywords": ["laravel-zero", "cli", "scaffold", "generator", "boilerplate", "namespace"],
    "homepage": "https://github.com/jeffersongoncalves/laravel-zero-package-scaffold",
    "license": "MIT",
    "authors": [
        { "name": "Jefferson Goncalves", "email": "jeffersongoncalves@users.noreply.github.com" }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "pestphp/pest": "^3.8|^4.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "JeffersonGoncalves\\LaravelZero\\PackageScaffold\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "JeffersonGoncalves\\LaravelZero\\PackageScaffold\\Tests\\": "tests/" }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse",
        "test:unit": "pest",
        "test": ["@test:unit", "@test:lint"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
